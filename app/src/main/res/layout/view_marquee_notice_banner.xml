<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noticeBannerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone"
    android:minHeight="38dp"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_marquee_ticker">

    <!-- Breaking News Ticker Badge -->
    <TextView
        android:id="@+id/noticeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📢 सूचना"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_marquee_badge"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

    <!-- Continuous Marquee Scrolling Notice TextView -->
    <TextView
        android:id="@+id/noticeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="6dp" />

    <!-- Dismiss Button -->
    <ImageView
        android:id="@+id/noticeDismissButton"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Dismiss notice" />
</LinearLayout>
